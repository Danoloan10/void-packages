usage_list() {
	cat <<EOF
Uso: $(basename "$0") list [opciones]

Genera los ficheros de fuentes de los paquetes instalados:
  source-repos.tsv        pkgname <TAB> homepage <TAB> distfiles <TAB> changelog
  source-repos-urls.txt   URLs únicas (homepage + distfiles), una por línea
  source-repos-plan.tsv   plan de resolución por paquete (offline)
  source-repos-git.tsv    repos git: URL <TAB> nombre <TAB> paquetes
  source-repos-lookup.tsv lookups de registro pendientes o sin resolver
  source-repos-nogit.tsv  paquetes cuyas fuentes no tienen repo git identificable
  source-repos-unresolved.txt  candidatos sin template local (repos custom)

Sin -W la resolución es offline (gramática de forges + tablas de mirrors).
Con -W se ejecuta la cascada completa con red: overrides (OVERRIDES_FILE),
homepage como repo git (git ls-remote, solo si falla se baja a la cascada),
verificación de candidatos y APIs de registro (PyPI, MetaCPAN, crates.io,
SourceForge, invent.kde.org).

Opciones (corta y larga):
  -c, --config FICHERO  Fichero de configuración adicional
  -o, --outdir DIR      Directorio de salida (defecto: directorio actual)
  -d, --voidpkgs DIR    Raíz del clon de void-packages
  -p, --pkgdb RUTA      pkgdb de XBPS (defecto: /var/db/xbps/pkgdb-*.plist)
  -W, --waterfall       Resolución con red (homepage-probe + APIs de registro)
  -v, --verbose         Log detallado (debug)
  -q, --quiet           Solo avisos y errores
      --log-level NIVEL debug | info | warn | error
  -h, --help            Esta ayuda
EOF
	exit "${USAGE_EXIT:-1}"
}

list::run() {
	opts::normalize ":c:o:d:p:Wvqh" \
		"config=c outdir=o voidpkgs=d pkgdb=p waterfall=W verbose=v quiet=q help=h" \
		"$@"
	set -- "${OPTS[@]}"

	local OPTIND=1 opt outdir="." pkgdb="" do_waterfall=false
	while getopts ":c:o:d:p:Wvqh" opt; do
		case "$opt" in
			c) OPT_CONF="$OPTARG" ;;
			o) outdir="$OPTARG" ;;
			d) export VOIDPKGS="$OPTARG" ;;
			p) export PKGDB="$OPTARG" ;;
			W) do_waterfall=true ;;
			v) LOG_LEVEL=debug ;;
			q) LOG_LEVEL=warn ;;
			h) USAGE_EXIT=0; usage_list ;;
			*) usage_list ;;
		esac
	done
	config::init
	local voidpkgs="${VOIDPKGS:-$(pwd)}"
	pkgdb="${PKGDB:-}"   # flag -p > entorno > fichero de config
	deps::need awk

	[ -d "$voidpkgs/srcpkgs" ] || die "no se encuentra srcpkgs en '$voidpkgs'"
	if [ -z "$pkgdb" ]; then
		set -- /var/db/xbps/pkgdb-*.plist
		[ -f "$1" ] || die "no se encontró pkgdb en /var/db/xbps/"
		pkgdb="$1"
	fi

	local tsv="$outdir/source-repos.tsv"
	local urls="$outdir/source-repos-urls.txt"
	local plan="$outdir/source-repos-plan.tsv"
	local git="$outdir/source-repos-git.tsv"
	local nogit="$outdir/source-repos-nogit.tsv"
	local lookup="$outdir/source-repos-lookup.tsv"
	local missing="$outdir/source-repos-unresolved.txt"
	mkdir -p "$outdir"
	: > "$missing"

	log::info "listando fuentes ($voidpkgs, pkgdb: $pkgdb)"
	list::collect "$voidpkgs" "$pkgdb" > "$tsv"

	# URLs únicas (homepage + distfiles)
	awk -F'\t' '{
		if ($2 != "") print $2
		n = split($3, u, " ")
		for (i = 1; i <= n; i++) if (u[i] != "") print u[i]
	}' "$tsv" | sort -u > "$urls"

	# Plan + cascada de resolución (con -W, la parte con red)
	plan::extract < "$tsv" > "$plan"
	if $do_waterfall; then
		resolve::run "$plan" "$git" "$nogit" "$lookup"
	else
		local _hp="$HOMEPAGE_PROBE" _vr="$VERIFY_REPOS" _rl="$REGISTRY_LOOKUP"
		HOMEPAGE_PROBE=false VERIFY_REPOS=false REGISTRY_LOOKUP=false
		resolve::run "$plan" "$git" "$nogit" "$lookup"
		HOMEPAGE_PROBE="$_hp" VERIFY_REPOS="$_vr" REGISTRY_LOOKUP="$_rl"
	fi

	log::info "paquetes fuente resueltos: $(wc -l < "$tsv") (+$MISSING_PKGS sin template local)"
	log::info "URLs únicas: $(wc -l < "$urls") | repos git: $(wc -l < "$git") | lookups: $(wc -l < "$lookup") | sin repo git: $(wc -l < "$nogit") ($nogit)"
}

# ============================================================================
# distfiles — mirror plano del conjunto actual de fuentes
# ============================================================================

distfiles::sha256() {
	sha256sum "$1" 2>/dev/null | awk '{print $1; exit}'
}

# distfiles::try URL PARTE — descarga (reanudable) a PARTE; 0 si ok
distfiles::try() {
	curl -fL --retry 2 --connect-timeout 15 --max-time "${DISTFILES_TIMEOUT:-300}" \
		-C - -o "$2" "$1" 2>/dev/null
}

# distfiles::fetch_one OUT NAME ORIG URL HASH PKGVER SEED MIRRORS
# Descarga NAME en OUT verificando HASH (si es sha256 de 64 hex; los
# checksums de contenido "@" se aceptan sin verificar). Cadena: presente
# → semilla → mirrors extra → upstream → repo-default (rescate) →
# sources.voidlinux.org/<pkgver> (archivo). Imprime "NAME<TAB>origen" o nada.
# ORIG es el nombre sin sufijo de conflicto: se usa para el hardlink
# versioned/<pkgver>/<ORIG> (layout sin colisiones, como sources.voidlinux).
distfiles::fetch_one() {
	local out="$1" name="$2" orig="$3" url="$4" hash="$5" pkgver="$6" seed="$7" mirrors="$8"
	local part="$out/.$name.part" sum cand label c m wl

	local verifiable=false
	if [ "${#hash}" -eq 64 ]; then
		case "$hash" in *[!0-9a-fA-F]*) : ;; *) verifiable=true ;; esac
	fi
	if $verifiable; then wl="${hash,,}"; else wl=""; fi

	check() {
		[ -f "$1" ] || return 1
		$verifiable || return 0
		sum=$(distfiles::sha256 "$1")
		[ "$sum" = "$wl" ]
	}

	install_link() {   # $1 = fichero fuente ya verificado
		ln -f "$1" "$out/$name" 2>/dev/null || cp -f "$1" "$out/$name" || return 1
		if [ -n "$wl" ]; then
			mkdir -p "$out/by_sha256"
			ln -f "$out/$name" "$out/by_sha256/${wl}_$name" 2>/dev/null || true
		fi
		if [ -n "$pkgver" ]; then
			mkdir -p "$out/versioned/$pkgver"
			ln -f "$out/$name" "$out/versioned/$pkgver/$orig" 2>/dev/null || true
		fi
		return 0
	}

	# 1) ya presente y válido
	if [ -f "$out/$name" ] && check "$out/$name"; then
		printf '%s\tpresente\n' "$name"
		return 0
	fi
	# 2) semilla (hostdir/sources: plano o by_sha256)
	if [ -n "$seed" ]; then
		for cand in "$seed/$name" "$seed/by_sha256/${wl}_$name"; do
			if [ -n "$wl" ] && [ -f "$cand" ] && check "$cand"; then
				if install_link "$cand"; then
					printf '%s\tsemilla\n' "$name"
					return 0
				fi
			fi
		done
	fi
	# 3) fuentes remotas, en orden
	local -a cands=()
	for m in $mirrors; do
		m="${m%/}"
		[ -n "$m" ] && cands+=("mirror"$'\t'"$m/$name")
	done
	cands+=("upstream"$'\t'"$url")
	cands+=("void-rescate"$'\t'"https://repo-default.voidlinux.org/distfiles/$name")
	if [ -n "$pkgver" ]; then
		cands+=("void-archivo"$'\t'"https://sources.voidlinux.org/$pkgver/$name")
	fi
	for c in "${cands[@]}"; do
		label="${c%%$'\t'*}"
		cand="${c#*$'\t'}"
		rm -f "$part"
		if distfiles::try "$cand" "$part"; then
			if check "$part"; then
				mv -f "$part" "$out/$name.part-ok"
				if install_link "$out/$name.part-ok"; then
					rm -f "$out/$name.part-ok"
					printf '%s\t%s\n' "$name" "$label"
					return 0
				fi
				rm -f "$out/$name.part-ok"
				return 1
			fi
			log::debug "checksum no válido desde $label: $cand"
		fi
	done
	rm -f "$part"
	return 1
}

# __fetch — interno para xargs -P: recibe "out US name US url US hash US
# pkgver US seed US mirrors" (US = separador de unidad, \x1f) y deja el
# resultado en stdout.
cmd___fetch() {
	local IFS=$'\037'
	local out name orig url hash pkgver seed mirrors
	read -r out name orig url hash pkgver seed mirrors <<< "$1"
	[ -n "$out" ] || return 0
	[ -n "$orig" ] || orig="$name"
	distfiles::fetch_one "$out" "$name" "$orig" "$url" "$hash" "$pkgver" "$seed" "$mirrors"
	return 0
}

usage_distfiles() {
	cat <<EOF
Uso: $(basename "$0") distfiles [opciones]

Descarga a OUTDIR el conjunto actual de distfiles de los paquetes
instalados, verificados con el checksum del template, en formato espejo
plano: el nombre de fichero es el mismo que usa xbps-src (sintaxis
url>nombre respetada), más un índice by_sha256/<sha256>_<fichero>
compatible con hostdir/sources, más un árbol versioned/<paquete>-<versión>/
sin colisiones (como sources.voidlinux.org). Los nombres planos que
colisionan entre paquetes se guardan como <nombre>.<hash8> en el layout
plano, pero siempre con su nombre canónico en versioned/.

Orden de fuentes por fichero: ya-presente → semilla (-S) → mirrors extra
(-M) → URL upstream → repo-default.voidlinux.org/distfiles (rescate) →
sources.voidlinux.org/<pkg>-<version> (archivo). Los checksums de
contenido ("@hash") se descargan sin verificar.

El resultado es directamente usable por xbps-src:
  XBPS_DISTFILES_FALLBACK="$PWD/void-distfiles"     (file://, requiere uchroot)
  XBPS_DISTFILES_FALLBACK="https://host/distfiles"  (servido por nginx, etc.)

Incremental: lo ya descargado y verificado no se redescarga; los fallos
quedan en $STATE_DIR_DEFAULT/distfiles-failed.tsv y se reintentan con -r;
-m N limita las descargas nuevas por pasada (pensado para cron).

Opciones (corta y larga):
  -c, --config FICHERO   Fichero de configuración adicional
  -o, --outdir DIR       Destino (defecto: ./void-distfiles)
  -d, --voidpkgs DIR     Raíz del clon de void-packages (defecto: pwd)
  -p, --pkgdb RUTA       pkgdb de XBPS (defecto: /var/db/xbps/pkgdb-*.plist)
  -m, --max N            Máx. descargas nuevas por pasada; 0 = ilimitado (50)
  -j, --jobs N           Descargas en paralelo (4)
  -S, --seed DIR         Directorio semilla (defecto: <voidpkgs>/hostdir/sources)
  -M, --mirror URL       Mirror extra (repetible; URL base, layout plano)
  -r, --retry            Reintentar los fallos cacheados
  -t, --dry-run          No descargar, solo mostrar qué haría
  -v, --verbose          Log detallado (debug)
  -q, --quiet            Solo avisos y errores
      --log-level NIVEL  debug | info | warn | error
  -h, --help             Esta ayuda
EOF
	exit "${USAGE_EXIT:-1}"
}

distfiles::run() {
	opts::normalize ":c:o:d:p:m:j:S:M:rtvqh" \
		"config=c outdir=o voidpkgs=d pkgdb=p max=m jobs=j seed=S mirror=M retry=r dry-run=t verbose=v quiet=q help=h" \
		"$@"
	set -- "${OPTS[@]}"

	local OPTIND=1 opt
	local outdir="void-distfiles" max="${DISTFILES_MAX:-50}" jobs="${DISTFILES_JOBS:-4}"
	local seed="${DISTFILES_SEED:-}" retry=false dry_run=false
	local -a extra_mirrors=()
	while getopts ":c:o:d:p:m:j:S:M:rtvqh" opt; do
		case "$opt" in
			c) OPT_CONF="$OPTARG" ;;
			o) outdir="$OPTARG" ;;
			d) export VOIDPKGS="$OPTARG" ;;
			p) export PKGDB="$OPTARG" ;;
			m) max="$OPTARG" ;;
			j) jobs="$OPTARG" ;;
			S) seed="$OPTARG" ;;
			M) extra_mirrors+=("$OPTARG") ;;
			r) retry=true ;;
			t) dry_run=true ;;
			v) LOG_LEVEL=debug ;;
			q) LOG_LEVEL=warn ;;
			h) USAGE_EXIT=0; usage_distfiles ;;
			*) usage_distfiles ;;
		esac
	done
	config::init
	mkdir -p "$STATE_DIR"
	deps::need awk curl sha256sum flock
	case "$max" in '' | *[!0-9]*) die "-m/--max debe ser numérico" ;; esac
	case "$jobs" in '' | *[!0-9]*) die "-j/--jobs debe ser numérico" ;; esac

	exec 9>"$STATE_DIR/lock"
	flock -n 9 || die "otra instancia de $(basename "$0") está en ejecución"

	local voidpkgs="${VOIDPKGS:-$(pwd)}"
	[ -d "$voidpkgs/srcpkgs" ] || die "no se encuentra srcpkgs en '$voidpkgs' (usa -d DIR o VOIDPKGS)"
	if [ -z "${PKGDB:-}" ]; then
		set -- /var/db/xbps/pkgdb-*.plist
		[ -f "$1" ] || die "no se encontró pkgdb en /var/db/xbps/"
		PKGDB="$1"
	fi
	if [ -z "$seed" ] && [ -d "$voidpkgs/hostdir/sources" ]; then
		seed="$voidpkgs/hostdir/sources"
		log::info "semilla: $seed (hostdir existente)"
	fi
	local mirrors="${DISTFILES_MIRRORS:-} ${extra_mirrors[*]}"
	mkdir -p "$outdir"
	export DISTFILES_TIMEOUT

	log::info "distfiles: $voidpkgs (pkgdb: $PKGDB) → $outdir"
	DISTFILES_TMP=$(mktemp -d)
	trap 'rm -rf "$DISTFILES_TMP"' EXIT
	local tmp="$DISTFILES_TMP"
	list::collect "$voidpkgs" "$PKGDB" > "$tmp/sources.tsv"
	log::info "paquetes: $(wc -l < "$tmp/sources.tsv") (+$MISSING_PKGS sin template local)"

	# caches de estado
	local done_f="$STATE_DIR/distfiles-done.tsv" failed_f="$STATE_DIR/distfiles-failed.tsv"
	touch "$done_f"
	declare -A DONE=() FAILED=()
	local f h s u r
	while IFS=$'\t' read -r f h s; do
		[ -n "$f" ] && DONE["$f"]="$h|$s"
	done < "$done_f"
	if [ -f "$failed_f" ]; then
		while IFS=$'\t' read -r u h r; do
			[ -n "$u" ] && FAILED["$u|$h"]=1
		done < "$failed_f"
	fi

	# lista de trabajo: url <TAB> nombre <TAB> hash(-) <TAB> pkg <TAB> version(-)
	awk -F'\t' '{
		n = split($3, uu, " "); l = split($6, ll, " "); c = split($7, hh, " ")
		for (i = 1; i <= n; i++) {
			if (uu[i] == "" || ll[i] == "") continue
			printf "%s\t%s\t%s\t%s\t%s\n", uu[i], ll[i], (i <= c && hh[i] != "" ? hh[i] : "-"), $1, ($5 != "" ? $5 : "-")
		}
	}' "$tmp/sources.tsv" > "$tmp/wanted.tsv"

	# plan: dedupe, conflictos de nombre, presentes, fallos cacheados, límite -m
	local joblist="$tmp/jobs"
	: > "$joblist"
	local url name hash pkg ver key size rec pkgver
	declare -A SEEN=() NAME_HASH=() JOB_URL=() JOB_HASH=()
	local c_have=0 c_skipfail=0 c_pending=0 c_conflict=0 considered=0
	while IFS=$'\t' read -r url name hash pkg ver; do
		[ -n "$url" ] || continue
		[ "$hash" = "-" ] && hash=""
		[ "$ver" = "-" ] && ver=""
		key="$name|$hash"
		[ -n "${SEEN[$key]:-}" ] && continue
		SEEN["$key"]=1
		# conflicto: mismo nombre local con hash distinto → variante .<hash8>
		orig="$name"
		if [ -n "${NAME_HASH[$name]:-}" ] && [ "${NAME_HASH[$name]}" != "$hash" ]; then
			if [ "${#hash}" -eq 64 ]; then
				name="$name.${hash:0:8}"
				c_conflict=$((c_conflict + 1))
				log::warn "conflicto de nombre: '$key' se guardará como '$name'"
			fi
		else
			NAME_HASH["$name"]="$hash"
		fi
		JOB_URL["$name"]="$url"
		JOB_HASH["$name"]="$hash"
		# presente y verificado (por cache done; sin rehashear)
		if [ -f "$outdir/$name" ]; then
			size=$(stat -c %s "$outdir/$name" 2>/dev/null || echo 0)
			rec="${DONE[$name]:-}"
			if [ -n "$rec" ] && [ "${rec#*|}" = "$size" ]; then
				if [ -z "$hash" ] || [ "${rec%%|*}" = "$hash" ]; then
					c_have=$((c_have + 1))
					continue
				fi
			fi
			# sin registro previo: verificar una sola vez
			if [ -n "$hash" ] && [ "$(distfiles::sha256 "$outdir/$name")" = "${hash,,}" ]; then
				printf '%s\t%s\t%s\n' "$name" "$hash" "$size" >> "$done_f"
				DONE["$name"]="$hash|$size"
				c_have=$((c_have + 1))
				continue
			fi
		fi
		if ! $retry && [ -n "${FAILED[$url|$hash]:-}" ]; then
			c_skipfail=$((c_skipfail + 1))
			continue
		fi
		if [ "$max" != "0" ] && [ "$considered" -ge "$max" ]; then
			c_pending=$((c_pending + 1))
			continue
		fi
		considered=$((considered + 1))
		pkgver=""
		[ -n "$ver" ] && pkgver="$pkg-$ver"
		if $dry_run; then
			log::info "descargaría: $name <- $url"
		else
			printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' \
				"$outdir" "$name" "$orig" "$url" "$hash" "$pkgver" "$seed" "$mirrors" >> "$joblist"
		fi
	done < "$tmp/wanted.tsv"

	if $dry_run; then
		log::info "dry-run: presentes=$c_have a-descargar=$considered pendientes=$c_pending fallidos-cache=$c_skipfail conflictos=$c_conflict"
		return 0
	fi

	# descarga (paralela con xargs; una línea de joblist por invocación)
	local results="$tmp/results"
	: > "$results"
	if [ -s "$joblist" ]; then
		log::info "descargando $(wc -l < "$joblist") ficheros (jobs=$jobs, timeout=${DISTFILES_TIMEOUT}s)"
		if [ "$jobs" -gt 1 ] && command -v xargs >/dev/null; then
			xargs -r -a "$joblist" -d '\n' -n 1 -P "$jobs" \
				bash "$0" __fetch >> "$results" || true
		else
			while IFS= read -r spec; do
				cmd___fetch "$spec" >> "$results"
			done < "$joblist"
		fi
	fi

	# consolidar: éxitos → done.tsv; el resto → failed.tsv
	declare -A GOT=() OKKEY=()
	local c_up=0 c_mir=0 c_res=0 c_arch=0 c_sem=0 c_fail=0
	while IFS=$'\t' read -r name label; do
		[ -n "$name" ] || continue
		GOT["$name"]=1
		OKKEY["${JOB_URL[$name]:-}|${JOB_HASH[$name]:-}"]=1
		case "$label" in
			upstream) c_up=$((c_up + 1)) ;;
			mirror) c_mir=$((c_mir + 1)) ;;
			void-rescate) c_res=$((c_res + 1)) ;;
			void-archivo) c_arch=$((c_arch + 1)) ;;
			semilla) c_sem=$((c_sem + 1)) ;;
			presente) c_have=$((c_have + 1)) ;;
		esac
		size=$(stat -c %s "$outdir/$name" 2>/dev/null || echo 0)
		printf '%s\t%s\t%s\n' "$name" "${JOB_HASH[$name]:-}" "$size" >> "$done_f"
	done < "$results"
	: > "$failed_f.tmp"
	while IFS= read -r spec; do
		IFS=$'\037' read -r _out name _orig _url _hash _pv _sd _m <<< "$spec"
		if [ -z "${GOT[$name]:-}" ]; then
			c_fail=$((c_fail + 1))
			printf '%s\t%s\tno encontrado en ninguna fuente\n' "${JOB_URL[$name]:-}" "${JOB_HASH[$name]:-}" >> "$failed_f.tmp"
		fi
	done < "$joblist"
	# conservar los fallos previos, salvo los resueltos en esta tanda
	while IFS=$'\t' read -r u h r; do
		[ -n "$u" ] || continue
		[ -n "${OKKEY[$u|$h]:-}" ] && continue
		printf '%s\t%s\t%s\n' "$u" "$h" "$r" >> "$failed_f.tmp"
	done < <([ -f "$failed_f" ] && cat "$failed_f" || true)
	mv "$failed_f.tmp" "$failed_f"

	log::info "resumen: presentes=$c_have semilla=$c_sem upstream=$c_up mirror=$c_mir void-rescate=$c_res void-archivo=$c_arch fallidos=$c_fail pendientes=$c_pending fallidos-cache=$c_skipfail conflictos=$c_conflict"
	if [ "$c_fail" -gt 0 ]; then
		log::warn "ficheros sin obtener: $failed_f (reintentar con -r)"
		exit 1
	fi
	if [ "$c_pending" -gt 0 ]; then
		log::info "pendientes por límite -m $max: se descargarán en próximas ejecuciones"
	fi
	log::info "para xbps-src: XBPS_DISTFILES_FALLBACK=\"$outdir\" (file://) o sírvelo por HTTP y usa su URL"
	return 0
}

# ============================================================================
# subcomandos: archive y status
# ============================================================================

usage_archive() {
	cat <<EOF
Uso: $(basename "$0") archive [opciones]

Crea como mirrors en Gitea los repos git de las fuentes de los paquetes
instalados que aún no existan. Incremental: consulta los repos existentes en
el servidor y solo crea los que faltan (los fallos previos no se reintentan
salvo -r). Pensado para ejecutarse periódicamente (cron).

Opciones (corta y larga):
  -c, --config FICHERO    Fichero de configuración adicional
  -u, --url URL           URL base de Gitea
  -o, --owner OWNER       Owner destino (defecto: \$ARCHIVE_OWNER o el usuario del token)
  -m, --max N             Máx. mirrors nuevos por ejecución; 0 = ilimitado (defecto: $MAX_DEFAULT)
  -d, --voidpkgs DIR      Raíz del clon de void-packages
  -P, --public            Mirrors públicos (por defecto son privados)
  -t, --dry-run           Modo prueba: no crea nada, solo muestra qué haría
  -r, --retry             Reintentar los fallos registrados en $STATE_DIR_DEFAULT/failed.tsv
  -f, --force             Si un repo ya existe en el owner destino como mirror
                          con otra URL de origen, eliminarlo y volver a crearlo
                          con la URL esperada (nunca borra repos que no sean
                          mirrors)
  -v, --verbose           Log detallado (debug)
  -q, --quiet             Solo avisos y errores
      --log-level NIVEL   debug | info | warn | error
  -h, --help              Esta ayuda

Token: user:read + repository:write (+ organization:read si -o es una org).
Resolución pkg→repo: overrides → homepage (git ls-remote) → cascada
offline (gramática+tablas) → APIs de registro; ver "help list" (-W).
Verificación: los repos ya existentes en el destino deben ser mirrors del
origen esperado (original_url); si difieren, se registra conflicto y el
script termina con exit 1 (con -f, en cambio, se eliminan y se vuelven a
crear). Redirecciones: cada URL se comprueba con curl y, si redirige (HTTP
3xx), se usa la URL final como origen del mirror.
EOF
	exit "${USAGE_EXIT:-1}"
}

# archive::prepare — valida voidpkgs/pkgdb, genera TSV y extrae repos; deja
# ARCHIVE_TMP/TSV_FILE/REPOS_FILE listos. El cleanup de ARCHIVE_TMP se hace
# con trap EXIT en archive::run/status::run (los ficheros deben sobrevivir a
# esta función).
archive::prepare() {
	voidpkgs="${VOIDPKGS:-$(pwd)}"
	[ -d "$voidpkgs/srcpkgs" ] || die "no se encuentra srcpkgs en '$voidpkgs' (usa -d DIR o VOIDPKGS)"
	if [ -z "${PKGDB:-}" ]; then
		set -- /var/db/xbps/pkgdb-*.plist
		[ -f "$1" ] || die "no se encontró pkgdb en /var/db/xbps/"
		PKGDB="$1"
	fi

	log::debug "extrayendo fuentes de $voidpkgs"
	ARCHIVE_TMP=$(mktemp -d)
	list::collect "$voidpkgs" "$PKGDB" > "$ARCHIVE_TMP/sources.tsv"
	plan::extract < "$ARCHIVE_TMP/sources.tsv" > "$ARCHIVE_TMP/plan.tsv"
	resolve::run "$ARCHIVE_TMP/plan.tsv" "$ARCHIVE_TMP/repos.tsv" "$STATE_DIR/nogit.tsv"

	TSV_FILE="$ARCHIVE_TMP/sources.tsv"
	REPOS_FILE="$ARCHIVE_TMP/repos.tsv"
}

archive::load_failed() {
	FAILED_FILE="$STATE_DIR/failed.tsv"
	declare -gA FAILED=()
	declare -gA FAILED_INFO=()
	if [ -f "$FAILED_FILE" ]; then
		while IFS=$'\t' read -r canon name http msg; do
			[ -n "$canon" ] || continue
			FAILED["$canon"]=1
			FAILED_INFO["$canon"]="$name | HTTP $http | $msg"
		done < "$FAILED_FILE"
		log::debug "fallos cacheados: ${#FAILED[@]}"
	fi
}

archive::save_failed() {
	: > "$FAILED_FILE.tmp"
	local canon
	for canon in "${!FAILED[@]}"; do
		printf '%s\t%s\n' "$canon" "${FAILED_INFO[$canon]:-}" >> "$FAILED_FILE.tmp"
	done
	mv "$FAILED_FILE.tmp" "$FAILED_FILE"
}

archive::run() {
	opts::normalize ":c:u:o:m:d:PvfhtreLq" \
		"config=c url=u owner=o max=m voidpkgs=d public=P force=f dry-run=t retry=r verbose=v quiet=q help=h" \
		"$@"
	set -- "${OPTS[@]}"

	local OPTIND=1 opt owner="" max="${ARCHIVE_MAX:-$MAX_DEFAULT}"
	local dry_run=false retry=false private="${ARCHIVE_PRIVATE:-true}" force=false
	while getopts ":c:u:o:m:d:PvfhtreLq" opt; do
		case "$opt" in
			c) OPT_CONF="$OPTARG" ;;
			u) export GITEA_URL="$OPTARG" ;;
			o) owner="$OPTARG" ;;
			m) max="$OPTARG" ;;
			d) export VOIDPKGS="$OPTARG" ;;
			P) private=false ;;
			f) force=true ;;
			t) dry_run=true ;;
			r) retry=true ;;
			v) LOG_LEVEL=debug ;;
			q) LOG_LEVEL=warn ;;
			h) USAGE_EXIT=0; usage_archive ;;
			*) usage_archive ;;
		esac
	done
	config::init
	mkdir -p "$STATE_DIR"
	deps::need curl jq flock

	# Lock: evita pasadas solapadas (cron + manual)
	exec 9>"$STATE_DIR/lock"
	flock -n 9 || die "otra instancia de $(basename "$0") está en ejecución"

	local interval="${ARCHIVE_INTERVAL:-$INTERVAL_DEFAULT}"
	case "$max" in '' | *[!0-9]*) die "-m/--max debe ser numérico" ;; esac
	case "$private" in true | false) : ;; *) die "ARCHIVE_PRIVATE debe ser true o false" ;; esac

	archive::prepare
	archive::load_failed
	trap 'rm -rf "$ARCHIVE_TMP"' EXIT

	gitea::auth
	owner="${owner:-${ARCHIVE_OWNER:-$GITEA_LOGIN}}"

	log::info "pasada de archivado: owner=$owner max=${max} intervalo=$interval privado=$private force=$force dry-run=$dry_run"

	declare -A in_dest=() elsewhere=()
	while IFS=$'\t' read -r r_owner r_name; do
		[ -n "$r_owner" ] || continue
		if [ "$r_owner" = "$owner" ]; then
			in_dest["$r_name"]=1
		else
			elsewhere["$r_name"]="${elsewhere["$r_name"]:+${elsewhere["$r_name"]},}$r_owner"
		fi
	done < <(gitea::list_repos)
	log::info "repos en Gitea: ${#in_dest[@]} en '$owner', ${#elsewhere[@]} nombres en otros owners"

	local total=0 skip_exist=0 skip_failed=0 pending=0 created=0 errors=0 considered=0 recreated=0 url_errors=0
	local canon name pkgs mirror_url recreate=false t0
	while IFS=$'\t' read -r canon name pkgs; do
		[ -n "$canon" ] || continue
		total=$((total + 1))
		# Resolver redirecciones: la URL final es el origen del mirror
		mirror_url=$(url::resolve "$canon")
		recreate=false
		if [ -n "${in_dest[$name]:-}" ]; then
			# Existe en destino: el origen del mirror debe coincidir
			if gitea::verify_mirror "$owner" "$name" "$mirror_url"; then
				skip_exist=$((skip_exist + 1))
				continue
			fi
			# -f: solo se tocan los repos que SÍ son mirrors con otra URL de
			# origen; los que no son mirrors se denuncian como conflicto
			if ! $force || [ "$GITEA_IS_MIRROR" != true ]; then
				url_errors=$((url_errors + 1))
				continue
			fi
			recreate=true
			if $dry_run; then
				log::info "se eliminaría y volvería a crear: $owner/$name (apunta a '$GITEA_ORIGIN', esperado '$mirror_url')"
				recreated=$((recreated + 1))
				continue
			fi
			log::info "origen erróneo: $owner/$name apunta a '$GITEA_ORIGIN' (esperado '$mirror_url'); eliminando mirror"
			gitea::api DELETE "/repos/$owner/$name"
			case "$GITEA_HTTP" in
				204)
					log::info "eliminado: $owner/$name"
					unset "FAILED[$canon]"
					;;
				*)
					errors=$((errors + 1))
					FAILED["$canon"]=1
					FAILED_INFO["$canon"]="$name | HTTP $GITEA_HTTP | $(gitea::errmsg)"
					log::error "fallo eliminando $owner/$name: HTTP $GITEA_HTTP $(gitea::errmsg)"
					continue
					;;
			esac
		fi
		[ -n "${elsewhere[$name]:-}" ] && log::debug "$name existe en: ${elsewhere[$name]}"
		if [ "$recreate" != true ]; then
			if ! $retry && [ -n "${FAILED[$canon]:-}" ]; then
				log::debug "fallido en cache: $canon"
				skip_failed=$((skip_failed + 1))
				continue
			fi
			if [ "$max" != "0" ] && [ "$considered" -ge "$max" ]; then
				pending=$((pending + 1))
				continue
			fi
			considered=$((considered + 1))
		fi

		local desc="Mirror de $mirror_url — fuentes void: $pkgs"
		desc=${desc:0:200}
		local payload
		payload=$(jq -n \
			--arg clone_addr "$mirror_url" --arg repo_name "$name" \
			--arg repo_owner "$owner" --arg description "$desc" \
			--arg mirror_interval "$interval" --argjson private "$private" \
			'{clone_addr:$clone_addr, repo_name:$repo_name, repo_owner:$repo_owner,
			  description:$description, mirror_interval:$mirror_interval,
			  private:$private, mirror:true, service:"git"}')

		if $dry_run; then
			log::info "se crearía: $owner/$name <- $mirror_url"
			created=$((created + 1))
			continue
		fi

		if [ "$recreate" = true ]; then
			log::info "recreando: $owner/$name <- $mirror_url"
		else
			log::info "creando: $owner/$name <- $mirror_url"
		fi
		t0=$SECONDS
		gitea::api POST /repos/migrate "$payload"
		case "$GITEA_HTTP" in
			201)
				created=$((created + 1))
				if [ "$recreate" = true ]; then
					recreated=$((recreated + 1))
				fi
				printf '%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$mirror_url" "$name" >> "$STATE_DIR/created.log"
				unset "FAILED[$canon]"
				log::info "creado: $owner/$name ($((SECONDS - t0))s)"
				;;
			409)
				skip_exist=$((skip_exist + 1))
				log::warn "conflicto: $owner/$name ya existía (HTTP 409)"
				;;
			*)
				errors=$((errors + 1))
				FAILED["$canon"]=1
				FAILED_INFO[$canon]="$name | HTTP $GITEA_HTTP | $(gitea::errmsg)"
				log::error "fallo creando $owner/$name <- $canon: HTTP $GITEA_HTTP $(gitea::errmsg)"
				;;
		esac
	done < "$REPOS_FILE"

	if ! $dry_run; then
		archive::save_failed
	fi

	local nogit_n=0
	[ -f "$STATE_DIR/nogit.tsv" ] && nogit_n=$(wc -l < "$STATE_DIR/nogit.tsv")

	log::info "resumen: candidatos=$total existentes=$skip_exist creados=$created recreados=$recreated errores=$errors conflictos-origen=$url_errors fallidos-cache=$skip_failed pendientes=$pending (fuentes sin repo git: $nogit_n)"
	if ! $retry && [ "$skip_failed" -gt 0 ]; then
		log::info "reintentar fallos con: $(basename "$0") archive -r"
	fi
	if [ "$pending" -gt 0 ]; then
		log::info "pendientes por límite -m $max: $pending — se crearán en próximas ejecuciones"
	fi
	if ! $dry_run && [ "$created" -gt 0 ]; then
		log::info "registro de creaciones: $STATE_DIR/created.log"
	fi
	if [ $((errors + url_errors)) -gt 0 ]; then
		log::error "pasada terminada con errores (HTTP: $errors, conflictos de origen: $url_errors)"
		exit 1
	fi
}

usage_status() {
	cat <<EOF
Uso: $(basename "$0") status [opciones]

Muestra el estado del archivo: repos candidatos, existentes en Gitea,
pendientes de crear y fallos registrados. No crea ni modifica nada.

Opciones (corta y larga):
  -c, --config FICHERO  Fichero de configuración adicional
  -u, --url URL         URL base de Gitea
  -o, --owner OWNER     Owner destino (defecto: \$ARCHIVE_OWNER o el usuario del token)
  -d, --voidpkgs DIR    Raíz del clon de void-packages
  -n, --num N           Nº de pendientes a listar (defecto: 20)
  -v, --verbose         Log detallado (debug)
  -q, --quiet           Solo avisos y errores
      --log-level NIVEL debug | info | warn | error
  -h, --help            Esta ayuda
EOF
	exit "${USAGE_EXIT:-1}"
}

status::run() {
	opts::normalize ":c:u:o:d:n:vqh" \
		"config=c url=u owner=o voidpkgs=d num=n verbose=v quiet=q help=h" \
		"$@"
	set -- "${OPTS[@]}"

	local OPTIND=1 opt owner="" show=20
	while getopts ":c:u:o:d:n:vqh" opt; do
		case "$opt" in
			c) OPT_CONF="$OPTARG" ;;
			u) export GITEA_URL="$OPTARG" ;;
			o) owner="$OPTARG" ;;
			d) export VOIDPKGS="$OPTARG" ;;
			n) show="$OPTARG" ;;
			v) LOG_LEVEL=debug ;;
			q) LOG_LEVEL=warn ;;
			h) USAGE_EXIT=0; usage_status ;;
			*) usage_status ;;
		esac
	done
	config::init
	mkdir -p "$STATE_DIR"
	deps::need curl jq

	archive::prepare
	archive::load_failed
	trap 'rm -rf "$ARCHIVE_TMP"' EXIT

	gitea::auth
	owner="${owner:-${ARCHIVE_OWNER:-$GITEA_LOGIN}}"

	declare -A in_dest=() elsewhere=()
	while IFS=$'\t' read -r r_owner r_name; do
		[ -n "$r_owner" ] || continue
		if [ "$r_owner" = "$owner" ]; then
			in_dest["$r_name"]=1
		else
			elsewhere["$r_name"]="${elsewhere["$r_name"]:+${elsewhere["$r_name"]},}$r_owner"
		fi
	done < <(gitea::list_repos)
	log::info "Owner: $owner @ $GITEA_URL (${#in_dest[@]} repos, ${#elsewhere[@]} nombres en otros owners)"

	local total=0 skip_exist=0 skip_failed=0 pending=0 in_other=0 conflict=0 i=0
	local canon name pkgs mirror_url
	while IFS=$'\t' read -r canon name pkgs; do
		[ -n "$canon" ] || continue
		total=$((total + 1))
		# Resolver redirecciones: la URL final es el origen del mirror
		mirror_url=$(url::resolve "$canon")
		if [ -n "${in_dest[$name]:-}" ]; then
			skip_exist=$((skip_exist + 1))
			if ! gitea::verify_mirror "$owner" "$name" "$mirror_url"; then
				conflict=$((conflict + 1))
			fi
		elif [ -n "${elsewhere[$name]:-}" ]; then
			in_other=$((in_other + 1))
		elif [ -n "${FAILED[$canon]:-}" ]; then
			skip_failed=$((skip_failed + 1))
		else
			pending=$((pending + 1))
			if [ $i -lt "$show" ]; then
				printf '  pendiente: %-40s <- %s\n' "$name" "$canon" >&2
				i=$((i + 1))
			fi
		fi
	done < "$REPOS_FILE"

	local nogit_n=0
	[ -f "$STATE_DIR/nogit.tsv" ] && nogit_n=$(wc -l < "$STATE_DIR/nogit.tsv")
	log::info "repos candidatos: $total | en Gitea ($owner): $skip_exist (conflictos de origen: $conflict) | en otras orgs: $in_other | pendientes: $pending | fallidos: $skip_failed"
	log::info "fuentes sin repo git: $nogit_n ($STATE_DIR/nogit.tsv)"
	if [ "$pending" -gt "$show" ]; then
		log::debug "mostrando $show de $pending pendientes"
	fi
	return 0
}

# ============================================================================
# main
# ============================================================================

main() {
	[ $# -ge 1 ] || usage_general
	local cmd="$1"
	shift

	case "$cmd" in
		__probe) cmd___probe "$@" ;;
		__fetch) cmd___fetch "$@" ;;
		list) list::run "$@" ;;
		distfiles) distfiles::run "$@" ;;
		mirror) mirror::run "$@" ;;
		archive) archive::run "$@" ;;
		status) status::run "$@" ;;
		help | -h | --help)
			USAGE_EXIT=0
			case "${1-}" in
				list) usage_list ;;
				mirror) usage_mirror ;;
				distfiles) usage_distfiles ;;
				archive) usage_archive ;;
				status) usage_status ;;
				*) usage_general ;;
			esac
			;;
		*) usage_general ;;
	esac
}

# log::write necesita LOG_LEVEL definido incluso antes de config::init
LOG_LEVEL="${LOG_LEVEL:-info}"

main "$@"
