hostmakedepends="cmake clang lld llvm nasm perl yasm git"
# NO_ARMV81_OR_HIGHER: upstream's default aarch64 profile targets ARMv8.2
# (Graviton-class); this host target includes Raspberry Pi 4 (Cortex-A72,
# ARMv8.0), so build the maximum-compatibility profile (-march=armv8-a+crc).
configure_args="-DDISABLE_HERMETIC_BUILD=ON -DUSE_MUSL=ON -DENABLE_RUST=OFF -DENABLE_TESTS=OFF -DNO_ARMV81_OR_HIGHER=1"

post_extract() {
	# Place every vendored submodule into its path (159 pinned-commit
	# trees; see contrib/CMakeLists.txt). vsrcextract strips the leading
	# <repo>-<sha> top-level dir into the target path.
	while IFS='|' read -r _path _file; do
		mkdir -p "${_path}"
		vsrcextract -C "${_path}" "${_file}"
	done <<EOF_SUBMK
