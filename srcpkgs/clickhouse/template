# ClickHouse hard-requires Clang >= 21 + lld (cmake/tools.cmake) and rejects
# the cross gcc that the cmake build-style uses by default, so override
# do_configure with the style's logic but the upstream cross-musl toolchain.
do_configure() {
	local cmake_args=
	[ ! -d ${cmake_builddir:=build} ] && mkdir -p ${cmake_builddir}
	cd ${cmake_builddir}

	if [ -z "$CHROOT_READY" ]; then
		cat >bootstrap.cmake <<_EOF
SET(CMAKE_SYSTEM_NAME Linux)
SET(CMAKE_SYSTEM_VERSION 1)

SET(CMAKE_C_COMPILER   clang)
SET(CMAKE_CXX_COMPILER clang++)

SET(CMAKE_FIND_ROOT_PATH  "${XBPS_MASTERDIR}/usr;${XBPS_MASTERDIR}")

SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
_EOF
		configure_args+=" -DCMAKE_TOOLCHAIN_FILE=bootstrap.cmake"
	elif [ "$CROSS_BUILD" ]; then
		# Upstream's fully-static musl toolchain file; it brings the vendored
		# musl/libcxx/compiler-rt wiring and kernel headers from contrib/sysroot,
		# and does not override the compilers (CC/CXX still rule).
		cmake_args+=" -DCMAKE_TOOLCHAIN_FILE=${wrksrc}/cmake/linux/toolchain-aarch64-musl.cmake"
	fi
	cmake_args+=" -DCMAKE_INSTALL_PREFIX:PATH=/usr"
	cmake_args+=" -DCMAKE_BUILD_TYPE=None"
	cmake_args+=" -DCMAKE_INSTALL_LIBDIR:PATH=lib${XBPS_TARGET_WORDSIZE}"
	cmake_args+=" -DCMAKE_INSTALL_SYSCONFDIR:PATH=/etc"
	cmake_args+=" -DCMAKE_INSTALL_SBINDIR:PATH=bin"

	export CMAKE_GENERATOR="${CMAKE_GENERATOR:-Ninja}"
	# Remove -pipe: https://gitlab.kitware.com/cmake/cmake/issues/19590
	# With the upstream musl toolchain, Void's sysroot -I/-L must go: the
	# vendored musl headers must win over the system ones.
	# -fuse-ld=lld: clang would otherwise pick up the cross binutils' GNU ld
	# (aarch64-linux-musl-ld) from PATH, which lacks gcc's internal paths.
	# --gcc-toolchain=/usr: Void's cross gcc installs its internal files
	# (crtbeginS.o, libgcc.a) under the masterdir's /usr/lib/gcc, not inside
	# the sysroot, so clang cannot find them without a hint.
	CC=clang CXX=clang++ \
		CFLAGS="-DNDEBUG $(printf '%s' "$CFLAGS" | sed 's/ -I\/usr\/aarch64-linux-musl\/usr\/include//g; s/^ -I\/usr\/aarch64-linux-musl\/usr\/include//') ${CFLAGS/ -pipe /}" \
		CXXFLAGS="-DNDEBUG $(printf '%s' "$CXXFLAGS" | sed 's/ -I\/usr\/aarch64-linux-musl\/usr\/include//g; s/^ -I\/usr\/aarch64-linux-musl\/usr\/include//') ${CXXFLAGS/ -pipe /}" \
		LDFLAGS="$(printf '%s' "$LDFLAGS" | sed 's/ -L\/usr\/aarch64-linux-musl\/usr\/lib//g; s/^ -L\/usr\/aarch64-linux-musl\/usr\/lib//') -fuse-ld=lld --gcc-toolchain=/usr" \
		cmake ${XBPS_VERBOSE--Wno-dev} ${cmake_args} ${configure_args} \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		${LIBS:+-DCMAKE_C_STANDARD_LIBRARIES="$LIBS"} \
		${LIBS:+-DCMAKE_CXX_STANDARD_LIBRARIES="$LIBS"} \
		${wrksrc}/${build_wrksrc}

	# NOTE: we deliberately do NOT rewrite -isystem to -I (the build style
	# does that for other packages): ClickHouse relies on them being system
	# headers even with -Weverything -Werror. Taking that away breaks
	# builds, so we don't do it.
}

# clickhouse-server and clickhouse-keeper run as the _clickhouse user.
system_accounts="_clickhouse"
_clickhouse_homedir="/var/lib/clickhouse"
_clickhouse_descr="ClickHouse server user"
make_dirs="
 /var/lib/clickhouse 0750 _clickhouse _clickhouse"

post_install() {
	vlicense LICENSE

	# clickhouse-server runs in the foreground by default
	# (application.runAsDaemon=false in BaseDaemon.cpp), which is what
	# the runit service expects.
	vmkdir etc/clickhouse-server
	vinstall programs/server/config.xml 640 etc/clickhouse-server
	vinstall programs/server/users.xml 640 etc/clickhouse-server
	vsv clickhouse-server

	vmkdir etc/clickhouse-keeper
	vinstall programs/keeper/keeper_config.xml 640 etc/clickhouse-keeper
	vsv clickhouse-keeper
}

clickhouse-client_package() {
	short_desc+=" - client tools"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/bin/clickhouse-client
		# Upstream does not install man pages in non-doc builds.
		# vmove usr/share/man/man1/clickhouse-client.1
	}
}

clickhouse-keeper_package() {
	short_desc+=" - keeper service"
	depends="${sourcepkg}>=${version}_${revision}"
	conf_files="/etc/clickhouse-keeper/keeper_config.xml"
	make_dirs="
	 /var/lib/clickhouse-keeper 0750 _clickhouse _clickhouse
	 /var/log/clickhouse-keeper 0750 _clickhouse _clickhouse"
	pkg_install() {
		vmove usr/bin/clickhouse-keeper
		vmove etc/clickhouse-keeper
		vmove etc/sv/clickhouse-keeper
		# configs are installed group-readable only; make them readable by
		# the _clickhouse account that runs the service
		chmod 644 "${PKGDESTDIR}/etc/clickhouse-keeper/keeper_config.xml"
	}
}

clickhouse-server_package() {
	short_desc+=" - full server daemon"
	depends="${sourcepkg}>=${version}_${revision}"
	conf_files="/etc/clickhouse-server/config.xml /etc/clickhouse-server/users.xml"
	make_dirs="
	 /var/log/clickhouse-server 0750 _clickhouse _clickhouse"
	pkg_install() {
		vmove usr/bin/clickhouse-server
		vmove etc/clickhouse-server
		vmove etc/sv/clickhouse-server
		# configs are installed group-readable only; make them readable by
		# the _clickhouse account that runs the service
		chmod 644 "${PKGDESTDIR}/etc/clickhouse-server/config.xml" \
			"${PKGDESTDIR}/etc/clickhouse-server/users.xml"
	}
}
